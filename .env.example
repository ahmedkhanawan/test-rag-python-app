# Copy to backend/.env and adjust. Never commit real secrets.
APP_NAME="Company Knowledge Assistant"
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./app.db
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# OpenAI (never commit a real key)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.4-mini

# Qdrant (see docs/qdrant.md)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=company_documents

# Retrieval implementation defaults (not final decisions)
RETRIEVAL_TOP_K=5
# RETRIEVAL_SCORE_THRESHOLD=

# Admin auth: one admin account configured here (no user table).
# Hash: `cd backend && uv run python -m scripts.hash_password`; keep the hash in single quotes.
# JWT_SECRET: at least 32 random characters, e.g. `openssl rand -hex 32`. Never commit real values.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
