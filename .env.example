# Copy to backend/.env and adjust. Never commit real secrets.
APP_NAME="Company Knowledge Assistant"
# development | test | production. "production" refuses to start if secrets are missing or weak.
ENVIRONMENT=development
LOG_LEVEL=INFO
# text for local reading, json for log collectors (docker compose sets json).
LOG_FORMAT=text
DATABASE_URL=sqlite:///./app.db
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# OpenAI (never commit a real key)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.4-mini

# Qdrant (see docs/qdrant.md)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=company_documents

# Retrieval implementation defaults (not final decisions)
RETRIEVAL_TOP_K=5
# RETRIEVAL_SCORE_THRESHOLD=

# Admin auth: one admin account configured here (no user table).
# Hash: `cd backend && uv run python -m scripts.hash_password`; keep the hash in single quotes.
# JWT_SECRET: at least 32 random characters, e.g. `openssl rand -hex 32`. Never commit real values.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# Failed admin logins per client IP within the window before HTTP 429.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300
# Public chat endpoint: requests allowed per client IP per window (0 disables). In memory,
# per process; resets on restart.
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
# Largest accepted PDF upload, in MB.
MAX_UPLOAD_MB=20
# Browser origins allowed to call the API cross-origin, comma separated (https://host[:port]).
# Leave empty: the Vite dev proxy and the nginx container both make the app same-origin.
CORS_ORIGINS=
